# ─────────────────────────────────────────────────────────────
# TechSolvent Email Server — Environment Variables
# Copy these into Hostinger's Node.js App → Environment Variables
# ─────────────────────────────────────────────────────────────

# SMTP (Hostinger email)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=astitva@techsolvent.in
SMTP_PASS=your_email_password_here
SMTP_FROM=TechSolvent <astitva@techsolvent.in>

# Default Google Meet link
DEFAULT_MEET_LINK=https://meet.google.com/cmb-jcqy-iux

# CORS — must match your frontend domain exactly
ALLOWED_ORIGIN=https://techsolvent.in

# Port — Hostinger sets this automatically, leave as 3001 for local dev
PORT=3001
